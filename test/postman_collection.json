              "code": 200,
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refresh_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            }
          ]
        },
        {
          "name": "Get Rider Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{rider_token}}" }],
            "url": {
              "raw": "{{base_url}}/users/{{rider_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{rider_id}}"]
            },
            "description": "Fetch rider profile by ID. Requires JWT authentication."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": \"a1b2c3d4-0000-0000-0000-000000000000\",\n  \"name\": \"Sai Kumar\",\n  \"email\": \"sai@demo.com\",\n  \"phone\": \"+919999999999\",\n  \"rating\": 4.8,\n  \"rating_count\": 125,\n  \"created_at\": \"2026-03-08T10:00:00Z\"\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{ \"error\": \"missing or invalid token\" }"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('User fields present', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('id','name','email','phone','rating','rating_count','created_at');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
