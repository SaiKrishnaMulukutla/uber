            },
            "url": { "raw": "{{base_url}}/users/register", "host": ["{{base_url}}"], "path": ["users", "register"] },
            "description": "Create a new rider account. Returns JWT tokens and user profile.\n\n**Validation rules:**\n- name: 2–100 chars\n- email: valid format\n- phone: 10-15 digits\n- password: minimum 6 chars"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refresh_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"a1b2c3d4-0000-0000-0000-000000000000\",\n    \"name\": \"Sai Kumar\",\n    \"email\": \"sai@demo.com\",\n    \"phone\": \"+919999999999\",\n    \"rating\": 5,\n    \"rating_count\": 0,\n    \"created_at\": \"2026-03-08T10:00:00Z\"\n  }\n}"
            },
            {
              "name": "400 Invalid Input",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"error\": \"invalid email\" }"
            },
            {
              "name": "409 Duplicate Email",
              "status": "Conflict",
              "code": 409,
              "body": "{ \"error\": \"email already registered\" }"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('rider_token', body.access_token);",
                  "  pm.collectionVariables.set('rider_id', body.user.id);",
                  "  pm.test('Access token received', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
                  "  pm.test('User ID received', () => pm.expect(body.user.id).to.be.a('string').and.not.empty);",
                  "  console.log('rider_id:', body.user.id);",
                  "}"
