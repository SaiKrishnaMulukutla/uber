# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# JWT — openssl rand -base64 32
JWT_SECRET=

# Internal service secret — openssl rand -base64 32
INTERNAL_SECRET=

# Admin JWT (50-year) for admin-only endpoints
ADMIN_TOKEN=

# Email — Brevo as primary, SMTP as fallback
BREVO_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Payment — "cash" or "razorpay"
PAYMENT_PROVIDER=cash
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WebSocket origins (empty = allow all)
ALLOWED_ORIGINS=
