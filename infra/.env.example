# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# ── Service Databases (created by infra/init.sql) ─────────────
# users_db, drivers_db, trips_db, notifications_db, payments_db

# ── Infrastructure (used in docker-compose.yml) ───────────────
# KAFKA_BROKERS=kafka:9092      (internal to Docker network)
# REDIS_ADDR=redis:6379         (internal to Docker network)

# ── Host Ports (mapped in docker-compose.yml) ─────────────────
# API Gateway:          8000
# User Service:         8081
# Driver Service:       8082
# Trip Service:         8083
# Notification Service: 8084
# Payment Service:      8085
# PostgreSQL:           5433
# Redis:                6380
# Kafka:                9093
